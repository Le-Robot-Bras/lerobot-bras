# Copy to docker/.env and edit: cp .env.example .env

# ROS 2 domain (0-101). Use a distinct value per group sharing a machine/network.
ROS_DOMAIN_ID=54

# Set to true for simulation, false for real hardware
USE_SIM=true

# -- USE_SIM=false --

# Host serial port of the arm. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# Path to the calibration file (generated by lerobot-calibrate).
# Mounted read-only in the control container at /calibration/arm.json
CALIBRATION_FILE=~/.cache/huggingface/lerobot/calibration/robots/so_follower/my_awesome_follower_arm.json

# -- macOS / Docker Desktop (no USB passthrough): arm served from the host --
# Run tools/real_arm_server.py on the Mac (see tools/README.md), then:
#   USE_SIM=false
#   REMOTE_ARM=host.docker.internal:5555
# The arm stays limp and /joint_command is ignored until you set ARM_TORQUE=true
# (the server must also have been started with --allow-motion).
REMOTE_ARM=
ARM_TORQUE=false
