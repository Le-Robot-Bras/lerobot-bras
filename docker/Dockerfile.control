# CONTROL container — ROS2 Jazzy + SO-ARM101 driver (real + MuJoCo sim) + RViz
# Build: docker compose build control
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive \
    MUJOCO_GL=osmesa \
    PYOPENGL_PLATFORM=osmesa \
    LIBGL_ALWAYS_SOFTWARE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libosmesa6 \
    libgl1 \
    libgl1-mesa-dri \
    ros-jazzy-cv-bridge \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf-transformations \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-rviz2 \
    ros-jazzy-pinocchio \
    && rm -rf /var/lib/apt/lists/*

# Provided packages (driver + sim) and ikpy for the IK.
COPY core/lerobot_min /opt/so101/core
COPY sim /opt/so101/sim
RUN pip install --break-system-packages --no-cache-dir \
    "numpy<2" "opencv-python-headless==4.10.*" /opt/so101/core /opt/so101/sim ikpy

# YOLO (ultralytics) + MediaPipe
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libegl1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages --no-cache-dir \
    ultralytics mediapipe "numpy<2" && \
    pip uninstall -y --break-system-packages opencv-contrib-python opencv-python || true && \
    pip install --break-system-packages --no-cache-dir --force-reinstall --no-deps "opencv-python-headless==4.10.*"

# Auto-source ROS 2 in both interactive (.bashrc) and login (.profile) bash shells
RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc && \
    echo "[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash" >> /root/.bashrc && \
    echo "source /opt/ros/jazzy/setup.bash" >> /root/.profile && \
    echo "[ -f /ros2_ws/install/setup.bash ] && source /ros2_ws/install/setup.bash" >> /root/.profile

# ROS2 workspace mounted as a volume (see docker-compose.yml)
WORKDIR /ros2_ws

# RViz: needs forwarded X11 (DISPLAY + /tmp/.X11-unix, see compose)
# and `xhost +local:docker` on the host. Without GPU acceleration in the
# container, fallback: LIBGL_ALWAYS_SOFTWARE=1 rviz2
# Serial bus access for the real arm: see compose (device_cgroup_rules)
CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && bash"]
