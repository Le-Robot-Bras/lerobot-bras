# RViz-over-VNC container (macOS / any host without usable X11+GL)
# Xvfb + Mesa software GL, displayed in the browser through noVNC.
# Build: docker compose --profile vnc build rviz-vnc
FROM tek5/control

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11-utils \
    x11vnc \
    novnc \
    websockify \
    openbox \
    && rm -rf /var/lib/apt/lists/*

COPY docker/rviz_vnc_entrypoint.sh /opt/so101/rviz_vnc_entrypoint.sh
RUN chmod +x /opt/so101/rviz_vnc_entrypoint.sh

EXPOSE 6080
CMD ["/opt/so101/rviz_vnc_entrypoint.sh"]
